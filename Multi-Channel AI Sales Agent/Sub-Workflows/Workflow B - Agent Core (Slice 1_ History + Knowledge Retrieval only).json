    {
      "parameters": {
        "jsCode": "// Guard: a brand-new contact has no notes yet. Bound history size for a returning one.\nconst results = $json.results || [];\nconst ids = results.map(r => r.toObjectId).slice(0, 10); // last 10 notes max — bounded context, not unlimited history\nreturn { json: { note_ids: ids, has_history: ids.length > 0 } };"
      },
      "name": "Extract Note IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        448
      ],
      "id": "c0864587-b752-4da0-9515-06bf6e69e102",
      "notes": "Bounding to 10 is a deliberate choice: enough for real continuity, not so much it bloats every agent call with old, likely-irrelevant history."
    },
