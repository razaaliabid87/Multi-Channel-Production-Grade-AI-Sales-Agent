        "jsCode": "// Normalize each channel's send result to one shape before logging.\n// continueErrorOutput sends failures here without an 'error' wrapper in some node\n// versions — check for the presence of a real success indicator rather than assuming shape.\nconst failed = $json.error !== undefined;\nreturn { json: { output: $('AI Agent').item.json.output, send_success: !failed, send_error: failed ? String($json.error) : null } };"
