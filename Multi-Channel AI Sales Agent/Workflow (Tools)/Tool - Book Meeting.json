        }
      },
      "onError": "continueErrorOutput",
      "notes": "associationTypeId 200 is HubSpot's standard meeting-to-contact association — verify this against your portal's actual association type IDs in the live editor before trusting it (Rule 3); these can vary if custom associations exist."
    },
    {
      "parameters": {
        "jsCode": "const failed = $json.error !== undefined;\nif (failed) {\n  return { json: { success: false, reason: 'Meeting creation failed: ' + String($json.error) } };\n}\nreturn { json: { success: true, meeting_id: $json.id, scheduled_time: $('Validate Meeting Time').item.json.meeting_datetime_iso } };"
      },
