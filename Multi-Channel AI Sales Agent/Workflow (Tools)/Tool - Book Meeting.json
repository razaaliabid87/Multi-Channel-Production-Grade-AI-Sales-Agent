      "name": "Return Blocked - Needs Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        112
      ],
      "id": "3d3e8412-06ee-4b78-991d-db39a8791fa3"
    },
    {
      "parameters": {
        "jsCode": "// Basic sanity check — catches an obviously wrong datetime (past, unparseable)\n// before it reaches HubSpot. Not full calendar-availability validation (that's\n// HubSpot's own job when the meeting is actually created).\nconst raw = $json.meeting_datetime_iso;\nconst parsed = new Date(raw);\n\nif (isNaN(parsed.getTime())) {\n  return { json: { valid: false, reason: `Could not parse '${raw}' as a valid date/time.` } };\n}\nif (parsed.getTime() <= Date.now()) {\n  return { json: { valid: false, reason: 'The proposed meeting time is in the past.' } };\n}\n\nreturn { json: { valid: true, meeting_datetime_iso: parsed.toISOString(), meeting_title: $json.meeting_title || 'Sales call' } };"
      },
      "name": "Validate Meeting Time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        272
      ],
      "id": "679b7774-609c-4b29-b1d3-31a955f1d25e"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{$json.valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF - Time Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
