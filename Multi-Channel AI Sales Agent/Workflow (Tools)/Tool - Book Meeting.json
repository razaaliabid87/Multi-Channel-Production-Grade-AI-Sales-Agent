    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/meetings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  properties: {\n    hs_timestamp: new Date($json.meeting_datetime_iso).getTime(),\n    hs_meeting_title: $json.meeting_title,\n    hs_meeting_start_time: new Date($json.meeting_datetime_iso).getTime(),\n    hs_meeting_end_time: new Date($json.meeting_datetime_iso).getTime() + (30 * 60 * 1000),\n    hs_meeting_outcome: 'SCHEDULED'\n  },\n  associations: [\n    {\n      to: { id: $('When Executed by AI Agent').item.json.hubspot_contact_id },\n      types: [ { associationCategory: 'HUBSPOT_DEFINED', associationTypeId: 200 } ]\n    }\n  ]\n}) }}",
        "options": {}
      },
      "name": "Create Meeting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
