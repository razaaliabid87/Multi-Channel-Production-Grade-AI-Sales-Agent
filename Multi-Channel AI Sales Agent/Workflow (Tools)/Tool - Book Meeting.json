    {
      "parameters": {
        "content": "## Book Meeting\n\nReversible (can be rescheduled/cancelled) — no HITL gate needed per Rule 9, but still guarded by needs_review, plus a basic future-date sanity check since a wrong/past datetime from the agent is a real, if minor, failure mode worth catching before it hits HubSpot.",
        "height": 200,
        "width": 460
      },
      "name": "Sticky - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
