    },
    {
      "parameters": {
        "jsCode": "// Allowlist — the agent can only write real qualification fields, never anything\n// structural (no lifecyclestage overrides to arbitrary values, no internal HubSpot\n// system properties). Rejecting an unlisted property fails loudly, per Rule 5.\nconst ALLOWED_PROPERTIES = ['email', 'phone', 'firstname', 'lastname', 'hs_lead_status', 'jobtitle', 'company'];\n\nconst name = $json.property_name;\nif (!ALLOWED_PROPERTIES.includes(name)) {\n  return { json: { valid: false, reason: `Property '${name}' is not in the allowed list for automated updates.` } };\n}\nif (!$json.property_value || String($json.property_value).trim() === '') {\n  return { json: { valid: false, reason: 'property_value cannot be empty.' } };\n}\n\nreturn { json: { valid: true, property_name: name, property_value: $json.property_value } };"
      },
      "name": "Validate Property",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
